import { BaseRepository, OperationContext, TransactionRunner } from '@pong/db';
import { Service } from '@pong/di';
import { DataSource } from '@pong/typeorm';

import { MyFeatureEntity } from './my-feature.entity';

// File-private table: never exported, never registered with DI. Only the
// repository below reaches TypeORM, so nothing leaks into business logic.
class MyFeatureTable extends BaseRepository<MyFeatureEntity> {
	constructor(dataSource: DataSource, transactionRunner: TransactionRunner) {
		super(MyFeatureEntity, dataSource.manager, transactionRunner);
	}
}

@Service()
export class MyFeatureRepository {
	private readonly table: MyFeatureTable;

	constructor(dataSource: DataSource, transactionRunner: TransactionRunner) {
		this.table = new MyFeatureTable(dataSource, transactionRunner);
	}

	// Every data access is a named use-case method: plain params in, domain
	// shapes out, `ctx` last, manager resolved via `this.table.managerFor(ctx)`.
	async getSummary(ctx: OperationContext) {
		return await this.table.managerFor(ctx).count(MyFeatureEntity);
	}
}
