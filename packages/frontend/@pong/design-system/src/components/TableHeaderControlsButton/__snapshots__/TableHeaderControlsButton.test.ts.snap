exports[`TableHeaderControlsButton > should render correctly with all columns hidden 1`] = `
"<div class="container" width="260px" max-height="300px" scroll-type="auto">
  <trigger>
    <pong-button-stub icon="sliders-horizontal" variant="outline" size="medium" loading="false" icononly="false" disabled="false" class="false"></pong-button-stub>
  </trigger>
  <content>
    <div class="contentContainer">
      <!--v-if-->
      <div style="display: flex; flex-direction: column; gap: 2;" data-testid="hidden-columns-section">
        <h4 class="header">Hidden columns</h4>
        <fieldset class="column hidden" data-testid="hidden-column" data-column-key="col1">
          <pong-icon-stub icon="grip-vertical" spin="false" class="grip hidden"></pong-icon-stub><label>Column 1</label>
          <pong-icon-stub icon="eye-off" spin="false" class="visibilityToggle" data-testid="visibility-toggle-hidden"></pong-icon-stub>
        </fieldset>
        <fieldset class="column hidden" data-testid="hidden-column" data-column-key="col2">
          <pong-icon-stub icon="grip-vertical" spin="false" class="grip hidden"></pong-icon-stub><label>Column 2</label>
          <pong-icon-stub icon="eye-off" spin="false" class="visibilityToggle" data-testid="visibility-toggle-hidden"></pong-icon-stub>
        </fieldset>
        <fieldset class="column hidden" data-testid="hidden-column" data-column-key="col3">
          <pong-icon-stub icon="grip-vertical" spin="false" class="grip hidden"></pong-icon-stub><label>Column 3</label>
          <pong-icon-stub icon="eye-off" spin="false" class="visibilityToggle" data-testid="visibility-toggle-hidden"></pong-icon-stub>
        </fieldset>
        <fieldset class="column hidden" data-testid="hidden-column" data-column-key="col4">
          <pong-icon-stub icon="grip-vertical" spin="false" class="grip hidden"></pong-icon-stub><label>Column 4</label>
          <pong-icon-stub icon="eye-off" spin="false" class="visibilityToggle" data-testid="visibility-toggle-hidden"></pong-icon-stub>
        </fieldset>
        <fieldset class="column hidden" data-testid="hidden-column" data-column-key="col5">
          <pong-icon-stub icon="grip-vertical" spin="false" class="grip hidden"></pong-icon-stub><label>Column 5</label>
          <pong-icon-stub icon="eye-off" spin="false" class="visibilityToggle" data-testid="visibility-toggle-hidden"></pong-icon-stub>
        </fieldset>
      </div>
    </div>
  </content>
</div>"
`;

