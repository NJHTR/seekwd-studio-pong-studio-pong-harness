            <pong-icon-stub icon="grip-vertical" spin="false" class="grip"></pong-icon-stub><label>Column 3</label>
            <pong-icon-stub icon="eye" spin="false" class="visibilityToggle" data-testid="visibility-toggle-visible"></pong-icon-stub>
          </fieldset>
        </div>
        <div class="columnWrapper">
          <!--v-if-->
          <fieldset class="column draggable" draggable="true" data-testid="visible-column" data-column-key="col4">
            <pong-icon-stub icon="grip-vertical" spin="false" class="grip"></pong-icon-stub><label>Column 4</label>
            <pong-icon-stub icon="eye" spin="false" class="visibilityToggle" data-testid="visibility-toggle-visible"></pong-icon-stub>
          </fieldset>
        </div>
        <div class="columnWrapper">
          <!--v-if-->
          <fieldset class="column draggable" draggable="true" data-testid="visible-column" data-column-key="col5">
            <pong-icon-stub icon="grip-vertical" spin="false" class="grip"></pong-icon-stub><label>Column 5</label>
