{
	"extends": "@pong/typescript-config/tsconfig.frontend.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"rootDirs": [
			".",
			"../@pong/rest-api-client/src",
			"../@pong/composables/src",
			"../@pong/chat/src",
			"../@pong/design-system/src",
			"../@pong/frontend-module-sdk/src",
			"../@pong/frontend-utils/src",
			"../@pong/frontend-constants/src"
		],
		"noEmit": true,
		"types": [
			"vitest/globals",
			"unplugin-icons/types/vue",
			"vite-svg-loader",
			"../@pong/design-system/src/shims-modules.d.ts"
		],
		"paths": {
			"@/*": ["./src/*"],
			"@pong/rest-api-client*": ["../@pong/rest-api-client/src*"],
			"@pong/composables*": ["../@pong/composables/src*"],
			"@pong/constants*": ["../../@pong/constants/src*"],
			"@pong/frontend-module-sdk": ["../@pong/frontend-module-sdk/src/index.ts"],
			"@pong/frontend-module-promotions": ["../../modules/promotions/frontend/src/index.ts"],
			"@pong/frontend-module-promotions/*": ["../../modules/promotions/frontend/src/*"],
			"@pong/frontend-module-apps": ["../../modules/apps/frontend/src/index.ts"],
			"@pong/frontend-module-apps/*": ["../../modules/apps/frontend/src/*"],
			"@pong/frontend-module-self-healing": ["../../modules/self-healing/frontend/src/index.ts"],
			"@pong/frontend-module-self-healing/*": ["../../modules/self-healing/frontend/src/*"],
			"@pong/frontend-module-inbox": ["../../modules/inbox/frontend/src/index.ts"],
			"@pong/frontend-module-inbox/*": ["../../modules/inbox/frontend/src/*"],
			"@pong/frontend-module-mcp": ["../../modules/mcp/frontend/src/index.ts"],
			"@pong/frontend-module-mcp/*": ["../../modules/mcp/frontend/src/*"],
			"@pong/frontend-module-type-availability-policies": [
				"../../modules/type-availability-policies/frontend/src/index.ts"
			],
			"@pong/frontend-module-type-availability-policies/*": [
				"../../modules/type-availability-policies/frontend/src/*"
			],
			"@pong/frontend-module-insights": ["../../modules/insights/frontend/src/index.ts"],
			"@pong/frontend-module-insights/*": ["../../modules/insights/frontend/src/*"],
			"@pong/frontend-module-instance-registry": [
				"../../modules/instance-registry/frontend/src/index.ts"
			],
			"@pong/frontend-module-instance-registry/*": [
				"../../modules/instance-registry/frontend/src/*"
			],
			"@pong/frontend-module-otel": ["../../modules/otel/frontend/src/index.ts"],
			"@pong/frontend-module-otel/*": ["../../modules/otel/frontend/src/*"],
			"@pong/frontend-test-utils": ["../@pong/frontend-test-utils/src/index.ts"],
			"@pong/frontend-test-utils/*": ["../@pong/frontend-test-utils/src/*"],
			"@pong/frontend-utils*": ["../@pong/frontend-utils/src*"],
			"@pong/frontend-constants*": ["../@pong/frontend-constants/src*"],
			"@pong/chat*": ["../@pong/chat/src*"],
			"@pong/chat-hub*": ["../../@pong/chat-hub/src*"],
			"@pong/design-system": ["../@pong/design-system/src/index.ts"],
			"@pong/design-system/*": ["../@pong/design-system/src/*"],
			"@pong/i18n*": ["../@pong/i18n/src*"],
			"@pong/stores*": ["../@pong/stores/src*"],
			"@pong/telemetry": ["../../@pong/telemetry/src/index.ts"],
			"@pong/telemetry*": ["../../@pong/telemetry/src*"],
			"@pong/api-types*": ["../../@pong/api-types/src*"],
			"@pong/utils*": ["../../@pong/utils/src*"],
			"@pong/expression-runtime": ["./vite/expression-runtime-stub.ts"]
		},
		// TODO: remove all options below this line
		"useUnknownInCatchVariables": false
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
	"exclude": ["src/**/*.stories.ts", "src/plugins/codemirror/typescript/worker/**/*.d.ts"]
}
