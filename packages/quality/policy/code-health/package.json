{
	"name": "@pong/code-health",
	"private": true,
	"version": "0.1.0",
	"description": "Static analysis and code quality enforcement for the pong monorepo",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"code-health": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rimraf dist .turbo",
		"check": "tsx src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"build:unchecked": "tsc -p tsconfig.build.json --noCheck",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "biome format --write .",
		"format:check": "biome ci .",
		"lint": "oxlint --quiet",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"dependencies": {
		"@pong/rules-engine": "workspace:*",
		"@pong/vitest-config": "workspace:*",
		"change-case": "catalog:",
		"fast-glob": "catalog:",
		"markdown-it": "catalog:",
		"ts-morph": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:typescript",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@pong/eslint-config": "workspace:*",
		"@pong/oxlint-config": "workspace:*",
		"@types/markdown-it": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"fast-check": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"vitest": "catalog:"
	}
}
