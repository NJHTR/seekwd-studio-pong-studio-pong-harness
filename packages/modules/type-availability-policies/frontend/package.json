{
  "name": "@pong/frontend-module-type-availability-policies",
  "version": "0.9.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./__tests__/mocks": "./src/__tests__/mocks.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:changed": "janitor test-scoped",
    "test:dev": "vitest",
    "lint": "oxlint src --quiet && eslint src --quiet",
    "lint:fix": "oxlint src --fix && eslint src --fix",
    "format": "biome format --write . && prettier --write . --ignore-path ../../../../.prettierignore",
    "format:check": "biome ci . && prettier --check . --ignore-path ../../../../.prettierignore"
  },
  "dependencies": {
    "@pong/api-types": "workspace:*",
    "@pong/design-system": "workspace:*",
    "@pong/frontend-module-sdk": "workspace:*",
    "@pong/i18n": "workspace:*",
    "@pong/permissions": "workspace:*",
    "@pong/rest-api-client": "workspace:*",
    "@pong/stores": "workspace:*",
    "@pong/utils": "workspace:*",
    "@vueuse/core": "catalog:frontend",
    "pong-workflow": "workspace:*",
    "pinia": "catalog:frontend",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@iconify/json": "catalog:",
    "@pong/eslint-config": "workspace:*",
    "@pong/oxlint-config": "workspace:*",
    "@pong/frontend-test-utils": "workspace:*",
    "@pong/frontend-vite-config": "workspace:*",
    "@pong/playwright-janitor": "workspace:*",
    "@pong/typescript-config": "workspace:*",
    "@pong/vitest-config": "workspace:*",
    "@pinia/testing": "^0.1.6",
    "@testing-library/jest-dom": "catalog:frontend",
    "@testing-library/user-event": "catalog:frontend",
    "@testing-library/vue": "catalog:frontend",
    "@vitejs/plugin-vue": "catalog:frontend",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:frontend",
    "vite": "catalog:",
    "vite-svg-loader": "catalog:frontend",
    "vitest": "catalog:",
    "vue-tsc": "catalog:frontend"
  },
  "license": "UNLICENSED"
}
