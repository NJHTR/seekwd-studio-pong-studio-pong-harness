{
  "name": "pong",
  "version": "2.48.0",
  "description": "pong Workflow Automation Tool",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm run build:data && pnpm run build:agent-library",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck && tsc-alias -p tsconfig.build.json && pnpm run build:data && pnpm run build:agent-library",
    "build:data": "node scripts/build.mjs",
    "build:agent-library": "node scripts/bundle-agent-library.mjs",
    "buildAndDev": "pnpm run build && pnpm run dev",
    "dev": "concurrently -k -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"pnpm run watch\" \"nodemon --delay 1\"",
    "dev:worker": "concurrently -k -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"pnpm run watch\" \"nodemon worker\"",
    "dev:webhook": "concurrently -k -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"pnpm run watch\" \"nodemon webhook\"",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "oxlint --type-aware . --quiet",
    "lint:fix": "oxlint --type-aware . --fix",
    "recording:list": "node scripts/agent-integration-recordings.mjs --list",
    "recording:export": "node scripts/agent-integration-recordings.mjs",
    "start": "node ../../scripts/os-normalize.mjs --dir bin pong",
    "test": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run",
    "test:unit": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run",
    "test:unit:changed": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite janitor test-scoped",
    "test:integration": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run --config vitest.config.integration.ts",
    "test:integration:dev": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest --silent=false --config vitest.config.integration.ts",
    "test:integration:changed": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite janitor test-scoped -- --config vitest.config.integration.ts",
    "test:dev": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest --silent=false",
    "test:sqlite": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run --config vitest.config.integration.ts",
    "test:sqlite:migrations": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run --config vitest.config.migration.ts --coverage.enabled=false",
    "test:sqlite:migrations:tc": "PONG_LOG_LEVEL=silent DB_SQLITE_POOL_SIZE=4 DB_TYPE=sqlite vitest run --config vitest.config.migration.testcontainers.ts --coverage.enabled=false",
    "test:postgres": "PONG_LOG_LEVEL=silent DB_TYPE=postgresdb DB_POSTGRESDB_SCHEMA=alt_schema DB_TABLE_PREFIX=test_ vitest run --config vitest.config.integration.ts",
    "test:postgres:migrations": "PONG_LOG_LEVEL=silent DB_TYPE=postgresdb DB_POSTGRESDB_SCHEMA=alt_schema DB_TABLE_PREFIX=test_ vitest run --config vitest.config.migration.ts --coverage.enabled=false",
    "test:postgres:migrations:tc": "PONG_LOG_LEVEL=silent PONG_TEST_DISABLE_TEMPLATE_DB=1 DB_TYPE=postgresdb DB_POSTGRESDB_SCHEMA=alt_schema DB_TABLE_PREFIX=test_ vitest run --config vitest.config.migration.testcontainers.ts --coverage.enabled=false",
    "test:postgres:tc": "PONG_LOG_LEVEL=silent vitest run --config vitest.config.integration.testcontainers.ts",
    "test:postgres:integration:tc": "PONG_LOG_LEVEL=silent vitest run --config vitest.config.integration.testcontainers.ts",
    "test:mariadb": "echo true",
    "test:win": "set PONG_LOG_LEVEL=silent&& set DB_SQLITE_POOL_SIZE=4&& set DB_TYPE=sqlite&& vitest run",
    "test:dev:win": "set PONG_LOG_LEVEL=silent&& set DB_SQLITE_POOL_SIZE=4&& set DB_TYPE=sqlite&& vitest --silent=false",
    "test:sqlite:win": "set PONG_LOG_LEVEL=silent&& set DB_SQLITE_POOL_SIZE=4&& set DB_TYPE=sqlite&& vitest run --config vitest.config.integration.ts",
    "test:postgres:win": "set PONG_LOG_LEVEL=silent&& set DB_TYPE=postgresdb&& set DB_POSTGRESDB_SCHEMA=alt_schema&& set DB_TABLE_PREFIX=test_&& vitest run --config vitest.config.integration.ts",
    "test:mariadb:win": "echo true",
    "watch": "tsc-watch --compiler @typescript/native/bin/tsc -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\""
  },
  "bin": {
    "pong": "./bin/pong"
  },
  "keywords": [
    "automate",
    "automation",
    "IaaS",
    "iPaaS",
    "pong",
    "workflow"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin",
    "templates",
    "dist"
