{
	"extends": ["./tsconfig.json", "@pong/typescript-config/tsconfig.build.go.json"],
	"compilerOptions": {
		"composite": true,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"src/**/*.test.ts",
		"src/test-utils/**/*",
		"src/template/templates/**/template",
		"src/template/templates/shared"
	]
}
