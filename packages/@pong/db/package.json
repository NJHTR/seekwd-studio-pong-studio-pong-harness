{
  "name": "@pong/db",
  "version": "1.48.0",
  "scripts": {
    "clean": "rimraf dist .turbo .tmp-schema-docs",
    "gen:migration-index": "node scripts/generate-migration-index.mjs",
    "dev": "pnpm watch",
    "typecheck": "pnpm gen:migration-index && tsc --noEmit",
    "build": "pnpm gen:migration-index && tsc -p tsconfig.build.json",
    "build:unchecked": "pnpm gen:migration-index && tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "pnpm gen:migration-index && oxlint --quiet",
    "lint:fix": "pnpm gen:migration-index && oxlint --fix",
    "watch": "pnpm gen:migration-index && tsc -p tsconfig.build.json --watch",
    "test": "pnpm gen:migration-index && vitest run",
    "test:unit": "pnpm gen:migration-index && vitest run",
    "test:dev": "pnpm gen:migration-index && vitest --silent=false",
    "migration:new": "node scripts/new-migration.mjs",
    "schema:docs:sqlite": "node scripts/schema-docs.mjs doc --db=sqlite",
    "schema:docs:postgres": "node scripts/schema-docs.mjs doc --db=postgres",
    "schema:docs": "pnpm schema:docs:sqlite && pnpm schema:docs:postgres",
    "schema:check:sqlite": "node scripts/schema-docs.mjs diff --db=sqlite",
    "schema:check:postgres": "node scripts/schema-docs.mjs diff --db=postgres",
    "schema:check": "pnpm schema:check:sqlite && pnpm schema:check:postgres"
  },
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@pong/api-types": "workspace:*",
    "@pong/backend-common": "workspace:*",
    "@pong/config": "workspace:*",
    "@pong/constants": "workspace:*",
    "@pong/decorators": "workspace:*",
    "@pong/di": "workspace:*",
    "@pong/permissions": "workspace:*",
    "@pong/utils": "workspace:*",
    "@pong/typeorm": "workspace:*",
    "class-validator": "0.14.0",
    "flatted": "catalog:",
    "lodash": "catalog:",
    "pong-core": "workspace:*",
    "pong-workflow": "workspace:*",
    "nanoid": "catalog:",
    "p-lazy": "3.1.0",
    "uuid": "catalog:",
    "xss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pong/eslint-config": "workspace:*",
    "@pong/oxlint-config": "workspace:*",
    "@pong/typescript-config": "workspace:*",
    "@pong/vitest-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/lodash": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "express": "catalog:",
    "pong-containers": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "testcontainers": "catalog:",
    "@typescript/native": "catalog:typescript-tooling",
    "typescript": "catalog:typescript-tooling",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "license": "UNLICENSED"
}
