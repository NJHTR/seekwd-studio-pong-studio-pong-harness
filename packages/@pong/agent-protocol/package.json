{
  "name": "@pong/agent-protocol",
  "version": "0.1.0",
  "description": "Frozen multi-agent protocol v0.1 (envelope, six message kinds, content-addressed artifacts, adaptive handoff)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fixtures.d.ts",
      "default": "./dist/testing/fixtures.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false",
    "lint": "eslint --quiet .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pong/eslint-config": "workspace:*",
    "@pong/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:typescript",
    "vitest": "catalog:"
  },
  "license": "UNLICENSED"
}
