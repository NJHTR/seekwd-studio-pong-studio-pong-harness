{
  "name": "@pong/engine",
  "version": "0.28.0",
  "description": "pong workflow execution engine (v2)",
  "scripts": {
    "clean": "rimraf dist .turbo compiled",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "build:docker": "pnpm build && rimraf compiled && DOCKER_BUILD=true NODE_ENV=production pnpm --filter . --prod --config.inject-workspace-packages=true --config.package-import-method=copy deploy --no-optional compiled && rimraf compiled/pnpm-lock.yaml compiled/pnpm-workspace.yaml compiled/node_modules/.pnpm-workspace-state-v1.json && docker build -f ../../../docker/images/engine/Dockerfile -t pong-engine:local .",
    "start": "node dist/serve.js",
    "format": "biome format --write src",
    "format:check": "biome ci src",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --passWithNoTests",
    "test:dev": "vitest --watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "watch": "tsc -p tsconfig.build.json --watch"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@pong/config": "workspace:*",
    "@pong/constants": "workspace:*",
    "@pong/di": "workspace:*",
    "@pong/errors": "workspace:*",
    "@pong/typeorm": "workspace:*",
    "@pong/utils": "workspace:*",
    "express": "catalog:",
    "jsonwebtoken": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pong/eslint-config": "workspace:*",
    "@pong/oxlint-config": "workspace:*",
    "@pong/typescript-config": "workspace:*",
    "@pong/vitest-config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "pong-containers": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "supertest": "^7.1.1",
    "typescript": "catalog:typescript",
    "vitest": "catalog:"
  },
  "license": "UNLICENSED"
}
