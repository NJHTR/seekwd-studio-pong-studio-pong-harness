{
	"extends": [
		"@pong/typescript-config/tsconfig.common.json",
		"@pong/typescript-config/tsconfig.backend.json"
	],
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"paths": {
			"@/*": ["../src/*"]
		},
		"types": ["node"]
	},
	"include": ["**/*.ts"]
}
